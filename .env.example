# debian-watch configuration.
# Copy to .env and fill in. Never commit the filled file.

# Listen address inside the container.
DW_ADDR=:8111

# Admin account. The hash is bcrypt; generate it with:
#   htpasswd -bnBC 12 "" 'your-password' | tr -d ':\n'
# Keep the value in single quotes so the shell does not expand $.
DW_ADMIN_USER=admin
DW_ADMIN_PASS_HASH=

# How long a session stays valid. Any Go duration string.
DW_SESSION_TTL=12h

# Set false only for local plain-HTTP development.
DW_COOKIE_SECURE=true

# Set true only when the app really sits behind nginx, which sets X-Real-IP.
# If true while directly exposed, clients can spoof their IP past the login
# rate limiter.
DW_TRUST_PROXY_HEADER=false

# debug | info | warn | error
DW_LOG_LEVEL=info

# Read-only Docker socket proxy URL, for example http://docker-socket-proxy:2375.
# Leave empty to disable the container panel entirely. Never point this at a
# raw Docker socket: the proxy is what makes the access read-only.
DW_DOCKER_HOST=

# How often the host metrics are sampled. Also the history resolution.
DW_SAMPLE_INTERVAL=2s

# How often containers are polled. Each running container costs one stats call,
# so keep this well above the sample interval on a busy host.
DW_DOCKER_INTERVAL=10s

# Samples kept per series for the sparklines. 120 at a 2s interval is 4 minutes.
DW_HISTORY_SIZE=120
